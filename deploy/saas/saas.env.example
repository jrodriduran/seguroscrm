# Copia este archivo a /opt/saas/saas.env y complétalo (chmod 600).

# Dominio base: cada cliente queda en <cliente>.<BASE_DOMAIN>
BASE_DOMAIN=crm.ejemplo.com
ACME_EMAIL=operaciones@ejemplo.com

# Imagen del CRM (registry propio o local) y versión en producción
IMAGE=seguroscrm
VERSION=1.0.0

# Base de datos compartida
MYSQL_ROOT_PASSWORD=cambia-esto
MYSQL_BUFFER_POOL=1G
REDIS_MAXMEMORY=512mb

# Correo saliente por defecto para los clientes nuevos (Postmark)
MAIL_MAILER=postmark
POSTMARK_TOKEN=
MAIL_FROM_ADDRESS=no-reply@ejemplo.com

# Dónde se guardan los respaldos y cuántos días se conservan
BACKUP_DIR=/opt/saas/backups
BACKUP_KEEP_DAYS=14
