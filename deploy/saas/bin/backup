#!/usr/bin/env bash
# Respaldo de base de datos + archivos subidos.
#
#   backup <cliente>      un cliente
#   backup --all          todos (para el cron diario)
#
# Deja <BACKUP_DIR>/<cliente>/<cliente>-<fecha>.sql.gz y .storage.tgz y borra
# los de más de BACKUP_KEEP_DAYS días. Imprime la ruta del .sql.gz creado.
. "$(dirname "$0")/_lib.sh"

backup_one() {
    local t="$1" stamp dir db
    require_tenant "$t"
    stamp="$(date +%Y%m%d-%H%M%S)"
    dir="$BACKUP_DIR/$t"
    db="$(tenant_db "$t")"
    mkdir -p "$dir"; chmod 700 "$dir"

    docker exec "$MYSQL_CONTAINER" mysqldump -uroot -p"$MYSQL_ROOT_PASSWORD" \
        --single-transaction --quick --routines --triggers --no-tablespaces "$db" 2>/dev/null \
        | gzip > "$dir/$t-$stamp.sql.gz"
    [ -s "$dir/$t-$stamp.sql.gz" ] || die "Respaldo vacío de $t"

    docker run --rm -v "crm-${t}_storage:/s:ro" alpine tar czf - -C /s app > "$dir/$t-$stamp.storage.tgz"

    find "$dir" -name "$t-*" -mtime +"${BACKUP_KEEP_DAYS:-14}" -delete
    echo "$dir/$t-$stamp.sql.gz"
}

if [ "${1:-}" = "--all" ]; then
    for t in $(tenant_list); do
        backup_one "$t" || echo "✖ falló el respaldo de $t" >&2
    done
else
    backup_one "${1:-}"
fi
